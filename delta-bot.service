[Unit]
Description=Delta BTC Options Bot Service
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/delta-bot
ExecStart=/opt/delta-bot/venv/bin/python main.py
ExecStopPost=/opt/delta-bot/venv/bin/python /opt/delta-bot/watchdog.py --on-stop
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
EnvironmentFile=-/opt/delta-bot/.env
Environment=PYTHONUNBUFFERED=1
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
