# ==============================================================================
# Delta BTC Options Bot — Environment Configuration (.env)
# ==============================================================================

# --- Delta Exchange API Credentials ---
# Note: Whitelist your Oracle VM's static public IP on your Delta Exchange API key settings.
DELTA_API_KEY=your_api_key_here
DELTA_API_SECRET=your_api_secret_here

# Demo / Testnet Credentials (Optional, for account isolation testing)
DELTA_DEMO_API_KEY=your_demo_key_here
DELTA_DEMO_API_SECRET=your_demo_secret_here

# --- Bot Trading Mode ---
# Options: PAPER (Simulation) or LIVE (Real Trading).
# SAFETY FAIL-SAFE: If left blank or missing, bot unconditionally defaults to PAPER.
BOT_MODE=PAPER

# --- Web Dashboard & Networking ---
PORT=5000
# APP_URL=http://127.0.0.1:5000

# --- Strategy & Risk Configuration ---
STARTING_CAPITAL=50000
MANUAL_TOTAL_LOTS=1000

# --- Telegram Notifications & Mobile Bot ---
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# --- Watchdog & Heartbeat ---
# Sends periodic status updates (mode, equity, positions, VM RAM, uptime)
ENABLE_TELEGRAM_HEARTBEAT=true
HEARTBEAT_INTERVAL_MINS=60

# --- Offsite Secondary Backup (Disaster Recovery) ---
# Retains position & trade history in private GitHub Gist in case of VM failure
GITHUB_PAT=
GITHUB_GIST_ID=

# --- Logging ---
LOG_LEVEL=INFO
